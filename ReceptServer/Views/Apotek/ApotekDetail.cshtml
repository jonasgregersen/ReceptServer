@model DataTransferLayer.Models.Apotek

<div class="apotek-details">

    <h2>Apotek – Detaljer</h2>

    <div class="detail-row">
        @Html.LabelFor(m => m.Id)
        @Html.DisplayFor(m => m.Id)
    </div>

    <div class="detail-row">
        @Html.LabelFor(m => m.Navn)
        @Html.DisplayFor(m => m.Navn)
    </div>

    <div class="detail-row">
        @Html.LabelFor(m => m.Adresse)
        @Html.DisplayFor(m => m.Adresse)
    </div>

    <a asp-controller="Apotek" asp-action="Index" class="btn-primary">
        Tilbage
    </a>

    <a asp-controller="Apotek" asp-action="SearchRecept" class="btn-link">
        Fremsøg Recept
    </a>

</div>
