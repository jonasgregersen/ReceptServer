<a href="/">Gå tilbage</a>
<div class="search-container">
    @using (Html.BeginForm("Search", "Apotek", FormMethod.Get))
    {
        @Html.Label("Søg efter recept på CPR nummer:")
        @Html.TextBox("query", null, new { required = "required" })
        <button type="submit">Søg</button>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }
</div>