@model List<DataTransferLayer.Models.Recept>

<div class="recept-container">
    @foreach (var recept in Model)
    {
        <div class="recept-card">
            <div class="recept-header">
                <h2>Recept ID: @recept.Id</h2>
                <span>Oprettet: @recept.OprettelsesDato.ToString("dd-MM-yyyy")</span>
            </div>

            <div class="recept-info">
                <p><strong>Ydernummer:</strong> @recept.YderNummer</p>
                <p><strong>CPR:</strong> @recept.CprNummer</p>
                <p><strong>Lægehus ID:</strong> @recept.LægehusId</p>
            </div>

            <h3>Ordinationer</h3>
            @if (recept.Ordinationer != null && recept.Ordinationer.Count > 0)
            {
                <div class="ordination-list">
                    @foreach (var ord in recept.Ordinationer)
                    {
                        <div class="ordination-card">
                            @using (Html.BeginForm("UdleverOrdination", "Apotek", FormMethod.Post))
                            {
                                <div class="ordination-info">
                                    <p><strong>Lægemiddel:</strong> @ord.Lægemiddel</p>
                                    <p><strong>Dosis:</strong> @ord.Dosis</p>
                                    <p><strong>Udleveringer:</strong> @ord.FortagneUdleveringer / @ord.Udleveringer</p>
                                    <p><strong>Lukket:</strong> @(ord.Lukket ? "Ja" : "Nej")</p>
                                </div>

                                <div class="ordination-actions">
                                    <input type="number" name="antal" placeholder="Antal" min="1" />
                                    <input type="hidden" name="receptId" value="@recept.Id" />
                                    <input type="hidden" name="ordinationId" value="@ord.Id" />
                                    <button type="submit" @(ord.Lukket ? "disabled" : "")>Udlevér</button>
                                </div>
                            }

                            @if (TempData["Error"] != null)
                            {
                                <div class="alert alert-danger">
                                    @TempData["Error"]
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p>Ingen ordinationer.</p>
            }
        </div>
    }
</div>

<style>
    .recept-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .recept-card {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 15px;
        background-color: #f9f9f9;
    }

    .recept-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .recept-info p {
        margin: 2px 0;
    }

    .ordination-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .ordination-card {
        border: 1px dashed #aaa;
        padding: 10px;
        border-radius: 6px;
        background-color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ordination-info p {
        margin: 2px 0;
    }

    .ordination-actions {
        display: flex;
        flex-direction: column;
        gap: 5px;
        align-items: flex-start;
    }
</style>
