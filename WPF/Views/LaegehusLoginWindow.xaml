<Window x:Class="WPF.Views.LaegehusLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF.Views"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Yder Nummer:" Grid.Row="0" Margin="0 0 0 5"/>
        <TextBox x:Name="YdernummerTextBox" Grid.Row="1" Margin="0 0 0 15"/>


        <Button x:Name="LoginButton" Grid.Row="4" Content="Log ind" Width="120" Height="35"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Click="Login_Click"/>
    </Grid>
</Window>
